# Copy to .env and fill in. .env is not committed.

# Port the API and chat socket listen on. The phone reaches it at
# http://<this computer's Wi-Fi IP>:PORT
PORT=4000

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=
# Or, without Atlas, the local Docker one started by `npm run db:up`:
# MONGO_URL=mongodb://127.0.0.1:27018/forus
MONGO_DB=forus

# Signs sign-in tokens. Use a long random value, e.g. `openssl rand -hex 32`.
# Changing it signs everybody out.
JWT_SECRET=

# How long a sign-in lasts before the app has to sign in again.
JWT_EXPIRES_IN=30d

# Phone.Email (admin.phone.email → Profile Details). Verifies phone numbers.
PHONE_EMAIL_CLIENT_ID=15557258674807780720

# Google Gemini API Key for AI Vibe Search (100% Free at aistudio.google.com/apikey)
GEMINI_API_KEY=
